# Copy to .env for local development. Never commit .env.

APP_ENV=development
PORT=8080

# docker-compose Postgres
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433
DATABASE_URL=postgres://portfolio:change-me-local-only@127.0.0.1:5433/portfolio?sslmode=disable

# Comma-separated exact origins. Never "*" in production.
CORS_ORIGIN=http://localhost:3000

# Optional: upserted into admin_users on boot. Store only the bcrypt hash,
# never the plaintext password. Generate with:
#   htpasswd -bnBC 12 "" 'your-password' | tr -d ':\n'
ADMIN_EMAIL=
ADMIN_PASSWORD_BCRYPT_HASH=

MIGRATE_ON_BOOT=true
RATE_LIMIT_PER_MINUTE=120
# Only true behind a trusted reverse proxy (e.g. Fly.io edge).
TRUST_PROXY=false
