# Copy to .env for local development. Never commit .env.
# Values containing "$" (bcrypt hashes) must be single-quoted.

APP_ENV=development
PORT=8080

# docker-compose Postgres
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433
DATABASE_URL=postgres://portfolio:change-me-local-only@127.0.0.1:5433/portfolio?sslmode=disable
MIGRATE_ON_BOOT=true

# Comma-separated exact origins. Never "*" in production.
CORS_ORIGIN=http://localhost:3000

# Single admin, upserted on boot (any other admin rows are removed).
# Store only the bcrypt hash, never the plaintext. Generate with:
#   go run ./cmd/hashpassword
ADMIN_EMAIL=
ADMIN_PASSWORD_BCRYPT_HASH=''

# JWT (HS256). Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_HOURS=24

# Rate limits (per client IP, per minute)
RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=5
# Only true behind a trusted reverse proxy (Render: set CLIENT_IP_HEADER=CF-Connecting-IP).
TRUST_PROXY=false

# Image storage: "local" (dev, served at /uploads) or "r2" (production)
STORAGE_DRIVER=local
MAX_UPLOAD_BYTES=15728640
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:8080

# Cloudflare R2 (STORAGE_DRIVER=r2)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://images.example.com

# Optional: ask the web app to drop cached pages after content changes, so
# edits appear instantly (otherwise within the 60s ISR window). The secret
# must match REVALIDATE_SECRET in portfolio-web. Generate: openssl rand -hex 32
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=
